# Provider: langchain's init_chat_model string. Google is the default here.
ENGLISH_TEACHER_MODEL=google_genai:gemini-3.1-flash-lite
ENGLISH_TEACHER_TEMPERATURE=0.3
GOOGLE_API_KEY=...

# Optional overrides
# ENGLISH_TEACHER_DB=./sessions.sqlite
# ENGLISH_TEACHER_MIN_LESSONS=3
# ENGLISH_TEACHER_MIN_SKILL=0.60
# ENGLISH_TEACHER_PASS_MARK=0.70

# Langfuse tracing: leave both keys empty to keep it off.
# Get keys from https://cloud.langfuse.com (Settings > API Keys).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted URL

# Local logs, traces and token accounting (dashboard at /dashboard).
# The events database defaults to events.sqlite next to sessions.sqlite.
# ENGLISH_TEACHER_EVENTS_DB=./events.sqlite
# ENGLISH_TEACHER_PRICE_INPUT_PER_M=0.10
# ENGLISH_TEACHER_PRICE_OUTPUT_PER_M=0.40
# Storing prompt and student text in the local log is opt-in because it is
# student data. Off by default: only sizes, tokens, timings and labels.
# ENGLISH_TEACHER_LOG_PROMPTS=0

# Email alerts: a recipient and a server are enough. The Flask-Mail style names
# (MAIL_SERVER, MAIL_PORT, MAIL_USE_TLS, MAIL_USERNAME, MAIL_PASSWORD,
# MAIL_DEFAULT_SENDER) work as fallbacks, so an existing .env needs no changes.
# MAIL_PASSWORD is usually exported by the OS; load_env_file never overwrites it.
# Gmail: enable 2FA, then use an App Password (not your account password).
# ALERT_EMAIL_TO=you@example.com
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=you@gmail.com
# ALERT_SMTP_PASSWORD=your-app-password
# ALERT_EMAIL_FROM=you@gmail.com          # defaults to ALERT_SMTP_USER
# ALERT_SMTP_TLS=starttls                 # starttls | ssl | none
# Alert once per day when today's tokens cross this number. 0 turns it off.
# ENGLISH_TEACHER_DAILY_TOKEN_BUDGET=200000
